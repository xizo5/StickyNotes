{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "便签",
  "version": "0.4.0",
  "identifier": "com.zuo.stickynotes",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "quick-note",
        "url": "popup.html",
        "title": "便签",
        "width": 370,
        "height": 340,
        "minWidth": 300,
        "minHeight": 240,
        "center": true,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
